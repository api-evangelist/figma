{
  "opencollection": "1.0.0",
  "info": {
    "name": "Figma Activity Logs Dev Resources API",
    "version": "0.21.0"
  },
  "items": [
    {
      "info": {
        "name": "Dev Resources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Figma Create Dev Resources",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.figma.com/v1/dev_resources",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bulk create dev resources across multiple files. Dev resources that are successfully created will show up in the links_created array in the response."
        },
        {
          "info": {
            "name": "Figma Update Dev Resources",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.figma.com/v1/dev_resources",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bulk update dev resources across multiple files. Ids for dev resources that are successfully updated will show up in the `links_updated` array in the response."
        },
        {
          "info": {
            "name": "Figma Delete Dev Resource",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.figma.com/v1/files/:file_key/dev_resources/:dev_resource_id",
            "params": [
              {
                "name": "file_key",
                "value": "abc123xyz789",
                "type": "path",
                "description": "The file to delete the dev resource from. This must be a main file key, not a branch key."
              },
              {
                "name": "dev_resource_id",
                "value": "dev_res_123456",
                "type": "path",
                "description": "The id of the dev resource to delete."
              }
            ]
          },
          "docs": "Delete a dev resource from a file"
        }
      ]
    }
  ],
  "bundled": true
}