  "item": [
    {
      "id": "c32d859a-7f7b-4fee-be21-0568ebcdaee8",
      "name": "Images",
      "description": {
        "content": "Operations for rendering and exporting images from Figma files",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "46d86196-e0aa-47ce-9573-13b8fafd6731",
          "name": "Figma Render Images of File Nodes",
          "request": {
            "name": "Figma Render Images of File Nodes",
            "description": {
              "content": "Renders images from a file.\nIf no error occurs, `\"images\"` will be populated with a map from node IDs to URLs of the rendered images, and `\"status\"` will be omitted. The image assets will expire after 30 days. Images up to 32 megapixels can be exported. Any images that are larger will be scaled down.\nImportant: the image map may contain values that are `null`. This indicates that rendering of that specific node has failed. This may be due to the node id not existing, or other reasons such has the node having no renderable components. It is guaranteed that any node that was requested for rendering will be represented in this map whether or not the render succeeded.\nTo render multiple images from the same file, use the `ids` query parameter to specify multiple node ids.\n``` GET /v1/images/:key?ids=1:2,1:3,1:4 ```\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "images",
                ":file_key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "(Required) A comma separated list of node IDs to render."
                },
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "A specific version ID to get. Omitting this will get the current version of the file."
                },
                {
                  "disabled": false,
                  "key": "scale",
                  "value": "<number>",
                  "description": "A number between 0.01 and 4, the image scaling factor."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "png",
                  "description": "A string enum for the image output format."
                },
                {
                  "disabled": false,
                  "key": "svg_outline_text",
                  "value": "true",
                  "description": "Whether text elements are rendered as outlines (vector paths) or as `<text>` elements in SVGs."
                },
                {
                  "disabled": false,
                  "key": "svg_include_id",
                  "value": "false",
                  "description": "Whether to include id attributes for all SVG elements. Adds the layer name to the `id` attribute of an svg element."
                },
                {
                  "disabled": false,
                  "key": "svg_include_node_id",
                  "value": "false",
                  "description": "Whether to include node id attributes for all SVG elements. Adds the node id to a `data-node-id` attribute of an svg element."
                },
                {
                  "disabled": false,
                  "key": "svg_simplify_stroke",
                  "value": "true",
                  "description": "Whether to simplify inside/outside strokes and use stroke attribute if possible instead of `<mask>`."
                },
                {
                  "disabled": false,
                  "key": "contents_only",
                  "value": "true",
                  "description": "Whether content that overlaps the node should be excluded from rendering. Passing false (i.e., rendering overlaps) may increase processing time, since more of the document must be included in rendering."
                },
                {
                  "disabled": false,
                  "key": "use_absolute_bounds",
                  "value": "false",
                  "description": "Use the full dimensions of the node regardless of whether or not it is cropped or the space around it is empty. Use this to export text nodes without cropping."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "file_key",
                  "description": "(Required) File to export images from. This can be a file key or branch key. Use `GET /v1/files/:key` with the `branch_data` query param to get the branch key."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
